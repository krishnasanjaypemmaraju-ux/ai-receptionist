# Copy this file to ".env" and fill in the values.

# Your free Gemini API key (from https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# The Google Apps Script Web App URL (after you deploy apps-script.gs)
APPS_SCRIPT_URL=

# The shared secret — MUST match SECRET inside apps-script.gs
BOOKING_SECRET=CHANGE_ME_secret123

# The public host where THIS server is deployed (no protocol), e.g. harsha-connector.onrender.com
PUBLIC_HOST=

# Port (Render/Railway set this automatically; default 3000 locally)
PORT=3000
